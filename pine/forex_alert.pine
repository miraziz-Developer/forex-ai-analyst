//@version=5
indicator("Forex AI Analyst Trigger", overlay=true)

// Minimal trigger only — the AI analyst does the actual pattern/structure
// read server-side from real OHLC bars. This script just fires a webhook
// whenever price crosses a chosen EMA, so you get a check-in without
// re-implementing analysis logic in Pine Script.

emaLength = input.int(21, "EMA Length")
ema = ta.ema(close, emaLength)

crossedUp = ta.crossover(close, ema)
crossedDown = ta.crossunder(close, ema)

plot(ema, color=color.orange)

if crossedUp or crossedDown
    alert('{"ticker": "' + syminfo.ticker + '", "close": "' + str.tostring(close) + '", "time": "' + str.tostring(time) + '"}', alert.freq_once_per_bar_close)
