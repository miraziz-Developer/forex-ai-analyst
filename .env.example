# Azure AI Foundry (OpenAI-compatible) endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Twelve Data API key — https://twelvedata.com (free tier: 800 requests/day)
TWELVEDATA_API_KEY=

# Telegram bot — created via @BotFather, chat ID from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Turso (libSQL) database for the signal track record — free tier at
# turso.tech. Render's own free disk is wiped on every redeploy, so this
# has to live outside Render. Get both from the database's "Connect" /
# "Create Token" buttons in the Turso dashboard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Trading window (all times UTC). Full 24/5 coverage (forex trading days).
TRADING_DAYS=MON,TUE,WED,THU,FRI
TRADING_WINDOW_START=00:00
TRADING_WINDOW_END=23:59

# Reward/stop in pips, as "target/stop". Typical spread the AI should weigh
# into its reward/risk judgment. How long an unresolved signal waits before
# being marked EXPIRED instead of WIN/LOSS.
RISK_REWARD_PIPS=20/5
SPREAD_PIPS=1.5
SIGNAL_EXPIRY_HOURS=48

# Self-triggered scheduler: the AI itself runs a full read on every pair on
# this timer and only signals when it calls a TRADE WATCH (no indicator gate).
# Each check = 4 Twelve Data calls per pair (3 pairs = 12/check). A separate
# timer resolves open signals (1 call per open signal). With 24/5 coverage at
# 30/30 min, worst case is ~576 + 144 = 720 calls/day (free cap is 800) —
# don't lower either interval without doing the math again.
WATCH_PAIRS=EURUSD,GBPUSD,USDJPY
POLL_INTERVAL_MINUTES=30
RESOLVER_INTERVAL_MINUTES=30

PORT=5000
