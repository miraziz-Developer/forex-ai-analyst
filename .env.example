# Telegram bot — created via @BotFather, chat ID from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random secret for Telegram webhook verification. With PUBLIC_BASE_URL, webhook setup is automatic at startup.
TELEGRAM_WEBHOOK_SECRET=

# API access. Set a long random DASHBOARD_TOKEN to keep /api/signals private.
PUBLIC_BASE_URL=
DASHBOARD_TOKEN=

# Turso (libSQL) database for the signal track record — free tier at
# turso.tech. Render's own free disk is wiped on every redeploy, so this
# has to live outside Render. Get both from the database's "Connect" /
# "Create Token" buttons in the Turso dashboard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signal engine. donchian_4h (default) = the research lab's best walk-forward
# family (4h Donchian breakout, long only, exchange-side ATR stop, exit on a 4h
# close below the exit channel); the AI is only a veto. contextual_ai = the
# legacy LLM signal generator on 5m/15m/1h candles.
SIGNAL_ENGINE=donchian_4h
DONCHIAN_ENTRY_N=100
DONCHIAN_EXIT_N=20
DONCHIAN_STOP_ATR=3.0
DONCHIAN_LEVERAGE=3
# on | off - off trades every mechanical signal without asking the AI.
AI_VETO=on

# Primary AI brain: Claude on Azure AI Foundry (API-key auth). Endpoint is the
# project URL ending in /anthropic, e.g. https://<project>.services.ai.azure.com/anthropic
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_DEPLOYMENT=claude-opus-5
# low | medium | high | xhigh | max (higher = deeper reasoning, more tokens)
AZURE_ANTHROPIC_EFFORT=high

# Fallback when Claude is not configured, refuses, or is unreachable. Configure
# either standard OpenAI or all Azure OpenAI values. For Azure AI Foundry, use
# its OpenAI compatible endpoint (or the Azure resource URL) and deployment name.
OPENAI_API_KEY=
AI_TRADER_MODEL=gpt-4o-mini
# Mechanical floor: a PROPOSE_TRADE below this AI-stated confidence (0..100)
# is rejected before it ever reaches the exchange, regardless of rationale.
AI_MIN_TRADE_CONFIDENCE=70
# Anti-flood limits: at most one open position per pair, at most this many
# open at once, and a per-pair pause after a close.
MAX_CONCURRENT_POSITIONS=3
TRADE_COOLDOWN_MINUTES=60
AZURE_OPENAI_API_KEY=
# Either a full Azure AI Foundry endpoint ending in /openai/v1 or a resource URL.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Set all three values to place orders on the BingX VST (virtual-money/demo) domain only.
AUTO_EXECUTE_TRADES=false
BINGX_API_KEY=
BINGX_SECRET=
# Emergency brake. Set true to prevent every new VST order immediately.
KILL_SWITCH=false
# Keep VST keys trade-only: never enable withdrawal permission. Live-money credentials/endpoints are unsupported.
# Risk, leverage, R:R, cooldown and position size are selected by the AI per trade.
# Runtime risk is calculated from live VST equity, not a fixed USDT limit.
# Public BingX perpetual OHLCV: no BingX account or API key is needed.
MULTI_STRATEGY_PROVIDER=bingx
MULTI_STRATEGY_PAIRS=BTC-USDT,ETH-USDT,SOL-USDT,XRP-USDT,BNB-USDT
# Runs serially after closed 5m candles. Do not set below 300 seconds.
MULTI_STRATEGY_SCAN_INTERVAL_SECONDS=300
# Alert if a broker-confirmed VST position remains open longer than this. It is
# observability only; the system never force-closes or invents an outcome.
VST_OPEN_SLA_MINUTES=120
PORT=5000

# --- Self-hosting with ./deploy.sh (Docker) - ignored on Render ---
# Point a DNS A record for this hostname at the server; Caddy then obtains a
# Let's Encrypt certificate automatically and PUBLIC_BASE_URL is filled in for
# you. Leave empty to bind to 127.0.0.1 only (bring your own reverse proxy).
DOMAIN=
# Host port for the localhost binding (default 5000).
HOST_PORT=5000
