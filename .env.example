# Azure AI Foundry (OpenAI-compatible) endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Twelve Data API key — https://twelvedata.com (free tier: 800 requests/day)
TWELVEDATA_API_KEY=

# Telegram bot — created via @BotFather, chat ID from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading window (all times UTC). TRADING_DAYS=ALL disables the day filter.
TRADING_DAYS=MON,TUE,WED,THU,FRI
TRADING_WINDOW_START=12:00
TRADING_WINDOW_END=16:00

# Reward/stop in pips, as "target/stop"
RISK_REWARD_PIPS=20/5

# Self-triggered scheduler: the AI itself runs a full read on every pair on
# this timer and only signals when it calls a TRADE WATCH (no indicator gate).
# Each check = 4 Twelve Data calls per pair (3 pairs = 12/check). Free tier is
# 800 calls/day, so 25 min -> ~691/day (safe). Going below ~22 min risks the cap.
WATCH_PAIRS=EURUSD,GBPUSD,USDJPY
POLL_INTERVAL_MINUTES=25

PORT=5000
