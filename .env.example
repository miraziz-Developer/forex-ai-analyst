# Azure AI Foundry (OpenAI-compatible) endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Telegram bot — created via @BotFather, chat ID from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Turso (libSQL) database for the signal track record — free tier at
# turso.tech. Render's own free disk is wiped on every redeploy, so this
# has to live outside Render. Get both from the database's "Connect" /
# "Create Token" buttons in the Turso dashboard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Trading window (all times UTC). Crypto trades 24/7 so this defaults to no
# restriction at all — only change it if you deliberately want one.
TRADING_DAYS=ALL
TRADING_WINDOW_START=00:00
TRADING_WINDOW_END=23:59

# Target / max-stop as a percentage move from entry (not pips — crypto prices
# span wildly different scales, so percentage is the right unit here)
TARGET_PCT_STOP_PCT=1.5/0.6

# Self-triggered scheduler: the AI itself runs a full read on every pair on
# this timer and only signals when it calls a TRADE WATCH (no indicator gate).
# Market data comes from BingX's own public kline endpoint (no key, no rate
# limit like the old Twelve Data setup), so these intervals are just about
# how "live" you want the bot to feel, not an API budget.
WATCH_PAIRS=BTC-USDT,ETH-USDT
POLL_INTERVAL_MINUTES=20
RESOLVER_INTERVAL_MINUTES=15
SIGNAL_EXPIRY_HOURS=24

# --- Execution (optional) ---
# With AUTO_EXECUTE_TRADES=false (default), nothing below this line does
# anything — the bot stays analysis-only.
AUTO_EXECUTE_TRADES=false

# BingX demo (VST / virtual USDT) account — bingx.com/en/account/api.
# The SAME key/secret also works on BingX's real-money endpoint; this app
# is hardcoded (in broker.py) to only ever call the demo (open-api-vst)
# domain, so there is no config flag that could switch it to live trading.
BINGX_API_KEY=
BINGX_SECRET=

LEVERAGE=3
POSITION_SIZE_USDT=100
MAX_OPEN_POSITIONS=3

PORT=5000
